<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性：需要声明才能读到已安装游戏的 assets（官方参数命名用） -->
    <queries>
        <package android:name="com.netease.wotb" />
        <package android:name="com.netease.wotb.aligames" />
        <package android:name="com.netease.wotb.huawei" />
        <package android:name="com.netease.tksjsjz.yyxx.m4399" />
        <package android:name="com.tencent.tmgp.yongyong.tksjsjz" />
        <package android:name="com.wargaming.wotblitz" />
        <package android:name="com.wargaming.wotblitz.eu" />
        <package android:name="com.wargaming.wotblitz.na" />
        <package android:name="com.wargaming.wotblitz.asia" />
    </queries>

    <!-- 使用 SAF 文件选择器，无需任何存储权限 -->

    <application
        android:allowBackup="true"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DvplModHelper">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DvplModHelper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>